# 1) Copy this file:  cp .env.example .env.local
# 2) Open .env.local in your EDITOR (not the terminal). Set the value on the line below.
#    Never paste your API key as a shell command — it ends up in shell history and logs.
# 3) Run:  vercel dev --yes --listen 127.0.0.1:3000
#    (Port must be 3000 unless you changed it on purpose.)

ANTHROPIC_API_KEY=

# Maritaca (Sabiá-3). Tradução do JSON em inglês produzido pelo Claude Sonnet 4.5
# para português brasileiro nativo no passo 2 do pipeline de api/summary.js.
# Ver docs/adr/0001-summary-model-pipeline.md para a arquitetura.
# Obtenha a chave em https://plataforma.maritaca.ai/.
# Se ausente, Claude faz a tradução também (qualidade aceitável, voz menos nativa).
MARITACA_API_KEY=

# Optional. JWT for tiered API if you use it.
# JWT_SECRET=
