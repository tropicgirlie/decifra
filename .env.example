# 1) Copy this file:  cp .env.example .env.local
# 2) Open .env.local in your EDITOR (not the terminal). Set the value on the line below.
#    Never paste your API key as a shell command — it ends up in shell history and logs.
# 3) Run:  vercel dev --yes --listen 127.0.0.1:3000
#    (Port must be 3000 unless you changed it on purpose.)

ANTHROPIC_API_KEY=

# Optional — JWT for tiered API if you use it
# JWT_SECRET=
