{
  "functions": {
    "api/extract.js":        { "memory": 512, "maxDuration": 60 },
    "api/summary.js":        { "memory": 256, "maxDuration": 30 },
    "api/checkout.js":       { "memory": 256, "maxDuration": 30 },
    "api/verify-payment.js": { "memory": 256, "maxDuration": 30 },
    "api/webhook.js":        { "memory": 256, "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/og.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/exame/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ]
}
